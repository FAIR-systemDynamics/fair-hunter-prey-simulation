    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Lookup Effect of Deer Density on Predator Hunting Efficiency" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/lookup-effect-of-forage-availability-on-consumption> a skos:Concept ;
    rdfs:label "Lookup Effect of Forage Availability on Consumption" ;
    dcterms:description "Vensim Lookup for: This nonlinear or graphical function captures how Actual Consumption per Deer will change given the Ratio of Actual to Required Biomass. Deer will continue to eat a normal amount of forage until only about 30 percent of what is needed is available. Deer will then start to eat less as foraging becomes more difficult." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L234> ;
    skos:definition "Vensim Lookup for: This nonlinear or graphical function captures how Actual Consumption per Deer will change given the Ratio of Actual to Required Biomass. Deer will continue to eat a normal amount of forage until only about 30 percent of what is needed is available. Deer will then start to eat less as foraging becomes more difficult." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Lookup Effect of Forage Availability on Consumption" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/lookup-historical-deer-bot> a skos:Concept ;
    rdfs:label "Lookup Historical Deer BOT" ;
    dcterms:description "Lookup for: A reference mode showing the actual deer population estimates from 1900 through 1950. This is defined by the graphical function shown in the source. You can display this BOTG with the Deer Population to help tune the model parameters to match the historical record." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L244> ;
