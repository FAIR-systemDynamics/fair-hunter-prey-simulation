<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/lookup-effect-of-deer-density-on-predator-births> a skos:Concept ;
    rdfs:label "Lookup Effect of Deer Density on Predator Births" ;
    dcterms:description "Lookup for: Multiplier on the Net Predator Growth Rate. -1.0 at deer density 0, 0 at density 1 (births equal deaths), 1.5 at density 2 or more." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L219> ;
