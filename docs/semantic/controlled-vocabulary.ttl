    skos:prefLabel "Lookup Effect of Deer Density on Predator Births" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/lookup-effect-of-deer-density-on-predator-hunting-efficiency> a skos:Concept ;
    rdfs:label "Lookup Effect of Deer Density on Predator Hunting Efficiency" ;
    dcterms:description "Lookup for: Multiplier on Deer Predation. 0 when no deer are present, 1 at normal density, rising to 1.5 when deer are abundant; the slope flattens at both ends." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L226> ;
