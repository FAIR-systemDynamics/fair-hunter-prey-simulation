@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix kaibab: <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sd: <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/capacity> a skos:Concept ;
    rdfs:label "Resource-limited carrying capacity" ;
    dcterms:description "Available forage constrains the deer population that can be sustained." ;
    dcterms:source <https://pressbooks.lib.jmu.edu/sdlearningguide/chapter/chapter-4-introduction-to-system-dynamics-modeling/> ;
    skos:definition "Available forage constrains the deer population that can be sustained." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Resource-limited carrying capacity" ;
    sd:evidenceStatus "Literature" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/consumption> a skos:Concept ;
    rdfs:label "Herd forage consumption" ;
    dcterms:description "Total consumption combines herd size and intake per animal." ;
    dcterms:source <https://pressbooks.lib.jmu.edu/sdlearningguide/chapter/chapter-4-introduction-to-system-dynamics-modeling/> ;
    skos:definition "Total consumption combines herd size and intake per animal." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Herd forage consumption" ;
    sd:evidenceStatus "Literature" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/deer> a skos:Concept ;
    rdfs:label "Mule deer population" ;
    dcterms:description "Mule deer form the prey population in the Kaibab example." ;
    dcterms:source <https://pressbooks.lib.jmu.edu/sdlearningguide/chapter/chapter-4-introduction-to-system-dynamics-modeling/> ;
    skos:definition "Mule deer form the prey population in the Kaibab example." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Mule deer population" ;
    sd:evidenceStatus "Literature" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/feedback> a skos:Concept ;
    rdfs:label "Feedback and interdependence" ;
    dcterms:description "Changes in populations and resources affect subsequent rates of change." ;
    dcterms:source <https://pressbooks.lib.jmu.edu/sdlearningguide/chapter/chapter-4-introduction-to-system-dynamics-modeling/> ;
    skos:definition "Changes in populations and resources affect subsequent rates of change." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Feedback and interdependence" ;
    sd:evidenceStatus "Literature" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/forage> a skos:Concept ;
    rdfs:label "Available forage" ;
    dcterms:description "Forage is a renewable resource consumed by deer." ;
    dcterms:source <https://pressbooks.lib.jmu.edu/sdlearningguide/chapter/chapter-4-introduction-to-system-dynamics-modeling/> ;
    skos:definition "Forage is a renewable resource consumed by deer." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Available forage" ;
    sd:evidenceStatus "Literature" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/initial-state> a skos:Concept ;
    rdfs:label "Initial state" ;
    dcterms:description "Stocks require initial quantities to start a simulation." ;
    dcterms:source <https://pressbooks.lib.jmu.edu/sdlearningguide/chapter/chapter-4-introduction-to-system-dynamics-modeling/> ;
    skos:definition "Stocks require initial quantities to start a simulation." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Initial state" ;
    sd:evidenceStatus "Literature" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/overshoot> a skos:Concept ;
    rdfs:label "Overshoot and collapse" ;
    dcterms:description "Resource depletion can follow population growth beyond sustainable levels." ;
    dcterms:source <https://pressbooks.lib.jmu.edu/sdlearningguide/chapter/chapter-4-introduction-to-system-dynamics-modeling/> ;
    skos:definition "Resource depletion can follow population growth beyond sustainable levels." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Overshoot and collapse" ;
    sd:evidenceStatus "Literature" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/policy> a skos:Concept ;
    rdfs:label "Predator-removal policy" ;
    dcterms:description "Hunting removes predators after a chosen start year." ;
    dcterms:source <https://pressbooks.lib.jmu.edu/sdlearningguide/chapter/chapter-4-introduction-to-system-dynamics-modeling/> ;
    skos:definition "Hunting removes predators after a chosen start year." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Predator-removal policy" ;
    sd:evidenceStatus "Literature" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/predation> a skos:Concept ;
    rdfs:label "Predation" ;
    dcterms:description "Deer losses depend on predators and a response to deer density." ;
    dcterms:source <https://pressbooks.lib.jmu.edu/sdlearningguide/chapter/chapter-4-introduction-to-system-dynamics-modeling/> ;
    skos:definition "Deer losses depend on predators and a response to deer density." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Predation" ;
    sd:evidenceStatus "Literature" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/predators> a skos:Concept ;
    rdfs:label "Predator population" ;
    dcterms:description "Predators remove deer through predation; prey availability affects predator growth." ;
    dcterms:source <https://pressbooks.lib.jmu.edu/sdlearningguide/chapter/chapter-4-introduction-to-system-dynamics-modeling/> ;
    skos:definition "Predators remove deer through predation; prey availability affects predator growth." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Predator population" ;
    sd:evidenceStatus "Literature" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/reference-mode> a skos:Concept ;
    rdfs:label "Historical reference mode" ;
    dcterms:description "A historical population trajectory is used to compare model behavior." ;
    dcterms:source <https://pressbooks.lib.jmu.edu/sdlearningguide/chapter/chapter-4-introduction-to-system-dynamics-modeling/> ;
    skos:definition "A historical population trajectory is used to compare model behavior." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Historical reference mode" ;
    sd:evidenceStatus "Literature" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/regrowth> a skos:Concept ;
    rdfs:label "Forage regeneration" ;
    dcterms:description "Forage regrowth replenishes biomass, with growth limited by capacity." ;
    dcterms:source <https://pressbooks.lib.jmu.edu/sdlearningguide/chapter/chapter-4-introduction-to-system-dynamics-modeling/> ;
    skos:definition "Forage regrowth replenishes biomass, with growth limited by capacity." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Forage regeneration" ;
    sd:evidenceStatus "Literature" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/actual-biomass-growth-fraction> a skos:Concept ;
    rdfs:label "Actual Biomass Growth Fraction" ;
    dcterms:description "Regrowth fraction after scaling for how close forage is to the forest's carrying capacity." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L2> ;
    skos:definition "Regrowth fraction after scaling for how close forage is to the forest's carrying capacity." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Actual Biomass Growth Fraction" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/actual-consumption-per-deer> a skos:Concept ;
    rdfs:label "Actual Consumption per Deer" ;
    dcterms:description "Forage actually eaten per deer per year, reduced below the desired amount when forage is scarce." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L10> ;
    skos:definition "Forage actually eaten per deer per year, reduced below the desired amount when forage is scarce." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Actual Consumption per Deer" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/actual-fractional-net-growth-rate> a skos:Concept ;
    rdfs:label "Actual Fractional Net Growth Rate" ;
    dcterms:description "Fractional net growth rate after scaling for how adequate the Kaibab is to support further growth." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L18> ;
    skos:definition "Fractional net growth rate after scaling for how adequate the Kaibab is to support further growth." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Actual Fractional Net Growth Rate" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/auxilliary-time-to-deer> a skos:Concept ;
    rdfs:label "Auxilliary Time to Deer" ;
    dcterms:description "Auxilliary parameter to convert Year into Deer for the time series lookup." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L26> ;
    skos:definition "Auxilliary parameter to convert Year into Deer for the time series lookup." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Auxilliary Time to Deer" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/baseline-annual-kills-per-predator> a skos:Concept ;
    rdfs:label "Baseline Annual Kills per Predator" ;
    dcterms:description "The average number of deer killed per predator in a given year." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L31> ;
    skos:definition "The average number of deer killed per predator in a given year." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Baseline Annual Kills per Predator" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/baseline-biomass-growth-fraction> a skos:Concept ;
    rdfs:label "Baseline Biomass Growth Fraction" ;
    dcterms:description "Fractional net regrowth rate of forage when the forest is far below its own carrying capacity." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L36> ;
    skos:definition "Fractional net regrowth rate of forage when the forest is far below its own carrying capacity." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Baseline Biomass Growth Fraction" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/baseline-fractional-deer-growth-rate> a skos:Concept ;
    rdfs:label "Baseline Fractional Deer Growth Rate" ;
    dcterms:description "Fractional net growth rate of the deer herd when forage is abundant." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L42> ;
    skos:definition "Fractional net growth rate of the deer herd when forage is abundant." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Baseline Fractional Deer Growth Rate" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/baseline-fractional-predator-growth> a skos:Concept ;
    rdfs:label "Baseline Fractional Predator Growth" ;
    dcterms:description "Fraction by which the predator population grows each year when deer are abundant." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L47> ;
    skos:definition "Fraction by which the predator population grows each year when deer are abundant." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Baseline Fractional Predator Growth" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/deer-carrying-capacity-in-years> a skos:Concept ;
    rdfs:label "Deer Carrying Capacity in Years" ;
    dcterms:description "Number of years of forage needed to sustain the deer population." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L53> ;
    skos:definition "Number of years of forage needed to sustain the deer population." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Deer Carrying Capacity in Years" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/deer-density> a skos:Concept ;
    rdfs:label "Normalized deer density" ;
    dcterms:description "The ratio of deer to area, all of which is divided by a normal. Results in a scale where one is normal, anything above 1 indicates too many deer, and anything below 1 indicates too few deer compared to what is normal deer per acres." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L58> ;
    skos:altLabel "Deer Density" ;
    skos:definition "The ratio of deer to area, all of which is divided by a normal. Results in a scale where one is normal, anything above 1 indicates too many deer, and anything below 1 indicates too few deer compared to what is normal deer per acres." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Normalized deer density" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/deer-net-growth-rate> a skos:Concept ;
    rdfs:label "Deer Net Growth Rate" ;
    dcterms:description "Biflow. Net deer added or removed per year through births and natural deaths, before predation." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L69> ;
    skos:definition "Biflow. Net deer added or removed per year through births and natural deaths, before predation." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Deer Net Growth Rate" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/deer-population> a skos:Concept ;
    rdfs:label "Deer Population" ;
    dcterms:description "The number/stock of mule deer on the Kaibab Plateau. Increased by Deer Net Growth, decreased by Deer Predation." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L77> ;
    skos:definition "The number/stock of mule deer on the Kaibab Plateau. Increased by Deer Net Growth, decreased by Deer Predation." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Deer Population" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/deer-predation> a skos:Concept ;
    rdfs:label "Deer Predation" ;
    dcterms:description "Outflow from the Deer Population. Number of deer killed by predators each year." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L86> ;
    skos:definition "Outflow from the Deer Population. Number of deer killed by predators each year." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Deer Predation" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/desired-consumption-per-deer> a skos:Concept ;
    rdfs:label "Desired Consumption per Deer" ;
    dcterms:description "The amount of forage consumed by a single deer in a year, when abundant forage is available." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L95> ;
    skos:definition "The amount of forage consumed by a single deer in a year, when abundant forage is available." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Desired Consumption per Deer" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/effect-of-deer-density-on-predator-births> a skos:Concept ;
    rdfs:label "Effect of Deer Density on Predator Births" ;
    dcterms:description "Multiplier on the Net Predator Growth Rate. -1.0 at deer density 0, 0 at density 1 (births equal deaths), 1.5 at density 2 or more." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L101> ;
    skos:definition "Multiplier on the Net Predator Growth Rate. -1.0 at deer density 0, 0 at density 1 (births equal deaths), 1.5 at density 2 or more." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Effect of Deer Density on Predator Births" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/effect-of-deer-density-on-predator-hunting-efficiency> a skos:Concept ;
    rdfs:label "Effect of Deer Density on Predator Hunting Efficiency" ;
    dcterms:description "Multiplier on Deer Predation. 0 when no deer are present, 1 at normal density, rising to 1.5 when deer are abundant; the slope flattens at both ends." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L108> ;
    skos:definition "Multiplier on Deer Predation. 0 when no deer are present, 1 at normal density, rising to 1.5 when deer are abundant; the slope flattens at both ends." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Effect of Deer Density on Predator Hunting Efficiency" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/effect-of-forage-availability-on-consumption> a skos:Concept ;
    rdfs:label "Effect of Forage Availability on Consumption" ;
    dcterms:description "This nonlinear or graphical function captures how Actual Consumption per Deer will change given the Ratio of Actual to Required Biomass. Deer will continue to eat a normal amount of forage until only about 30 percent of what is needed is available. Deer will then start to eat less as foraging becomes more difficult." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L116> ;
    skos:definition "This nonlinear or graphical function captures how Actual Consumption per Deer will change given the Ratio of Actual to Required Biomass. Deer will continue to eat a normal amount of forage until only about 30 percent of what is needed is available. Deer will then start to eat less as foraging becomes more difficult." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Effect of Forage Availability on Consumption" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/final-time> a skos:Concept ;
    rdfs:label "FINAL TIME" ;
    dcterms:description "The final time for the simulation." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L339> ;
    skos:definition "The final time for the simulation." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "FINAL TIME" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/forage-biomass> a skos:Concept ;
    rdfs:label "Forage Biomass" ;
    dcterms:description "Forage available for deer to eat" ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L127> ;
    skos:definition "Forage available for deer to eat" ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Forage Biomass" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/forage-consumed-per-deer> a skos:Concept ;
    rdfs:label "Total herd forage consumption rate" ;
    dcterms:description "Total forage eaten by the whole herd each year. Despite the name this is a total, not a per-head rate." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L135> ;
    skos:altLabel "Forage Consumed per Deer" ;
    skos:definition "Total forage eaten by the whole herd each year. Despite the name this is a total, not a per-head rate." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Total herd forage consumption rate" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/fraction-predators-killed-per-year> a skos:Concept ;
    rdfs:label "Fraction Predators Killed per Year" ;
    dcterms:description "Fraction of predators killed each year." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L143> ;
    skos:definition "Fraction of predators killed each year." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Fraction Predators Killed per Year" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/historical-deer-bot> a skos:Concept ;
    rdfs:label "Historical Deer BOT" ;
    dcterms:description "A reference mode showing the actual deer population estimates from 1900 through 1950. This is defined by the graphical function shown in the source. You can display this BOTG with the Deer Population to help tune the model parameters to match the historical record." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L148> ;
    skos:definition "A reference mode showing the actual deer population estimates from 1900 through 1950. This is defined by the graphical function shown in the source. You can display this BOTG with the Deer Population to help tune the model parameters to match the historical record." ;
    skos:inScheme kaibab:vocabulary ;
    skos:prefLabel "Historical Deer BOT" ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#term/initial-deer-population> a skos:Concept ;
    rdfs:label "Initial Deer Population" ;
    dcterms:description "Exogenous variable used to set (and change) the initial size of the Deer Population." ;
