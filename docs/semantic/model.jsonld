      "@id": "kaibab:variable/lookup-historical-deer-bot",
      "@type": "sd:LookupFunction",
      "dcterms:description": "Lookup for: A reference mode showing the actual deer population estimates from 1900 through 1950. This is defined by the graphical function shown in the source. You can display this BOTG with the Deer Population to help tune the model parameters to match the historical record.",
      "dcterms:source": {
        "@id": "https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L244"
      },
      "rdfs:label": "Lookup Historical Deer BOT",
      "sd:declaredIn": {
        "@id": "kaibab:file/models/kaibab_ecosystem_model.mdl"
      },
      "sd:denotesConcept": {
        "@id": "kaibab:term/lookup-historical-deer-bot"
      },
      "sd:equation": "( [(1900,0)-(1950,90000)],(1900,4000),(1902.5,4000),(1905,4000),(1907.5,5000) ,(1910,9000),(1912.5,15000),(1915,25000),(1917.5,35000),(1920,65000),(1922.5,90000) ,(1925,60000),(1927.5,37000),(1930,25000),(1932.5,20000),(1935,18000),(1937.5,12000) ,(1940,10000),(1942.5,7000),(1945,5000),(1947.5,3000),(1950,2000) )",
      "sd:evidenceStatus": "Extracted",
      "sd:hasBinding": {
        "@id": "kaibab:binding/variable-lookup-historical-deer-bot-models-kaibab-ecosystem-model-mdl-model-symbol-lookup-historical-deer-bot"
      },
      "sd:sourceLine": 244,
      "sd:sourceUnit": "Deer"
    },
