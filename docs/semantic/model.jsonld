      "@id": "kaibab:variable/effect-of-forage-availability-on-consumption",
      "@type": [
        "sd:Auxiliary",
        "m4i:NumericalVariable"
      ],
      "dcterms:description": "This nonlinear or graphical function captures how Actual Consumption per Deer will change given the Ratio of Actual to Required Biomass. Deer will continue to eat a normal amount of forage until only about 30 percent of what is needed is available. Deer will then start to eat less as foraging becomes more difficult.",
      "dcterms:source": {
        "@id": "https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L116"
      },
      "m4i:hasSymbol": "Effect of Forage Availability on Consumption",
      "m4i:hasUnit": {
        "@id": "kaibab:unit/dmnl"
      },
      "m4i:hasVariableDescription": "This nonlinear or graphical function captures how Actual Consumption per Deer will change given the Ratio of Actual to Required Biomass. Deer will continue to eat a normal amount of forage until only about 30 percent of what is needed is available. Deer will then start to eat less as foraging becomes more difficult.",
      "rdfs:label": "Effect of Forage Availability on Consumption",
      "sd:declaredIn": {
        "@id": "kaibab:file/models/kaibab_ecosystem_model.mdl"
      },
      "sd:denotesConcept": {
        "@id": "kaibab:term/effect-of-forage-availability-on-consumption"
      },
