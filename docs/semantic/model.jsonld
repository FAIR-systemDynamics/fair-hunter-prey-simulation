    {
      "@id": "kaibab:mechanism/consumption-depletion",
      "@type": "sd:Mechanism",
      "dcterms:description": "The implemented consumption outflow multiplies the herd size by actual intake per deer. Intake is reduced through a nonlinear lookup when forage becomes scarce. Depletion therefore changes both intake and the capacity supporting future deer growth.",
      "dcterms:source": [
        {
          "@id": "https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L77"
        },
        {
          "@id": "https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/docs/kaibab_example.md"
        }
      ],
      "rdfs:label": "Consumption and forage depletion",
      "sd:evidenceStatus": "Interpreted",
      "sd:explainsConcept": [
        {
          "@id": "kaibab:concept/consumption"
        },
        {
          "@id": "kaibab:concept/overshoot"
        }
      ],
