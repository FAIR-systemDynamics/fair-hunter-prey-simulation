    rdfs:label "hasAssignment" ;
    rdfs:comment "A parameter assignment included in a configuration." .

sd:hasBinding a owl:ObjectProperty ;
    rdfs:label "hasBinding" ;
    rdfs:comment "A concrete file selector associated with a variable." .

sd:hasLookup a owl:ObjectProperty ;
    rdfs:label "hasLookup" ;
    rdfs:comment "Table function determining a mechanism." .

sd:hasVariable a owl:ObjectProperty ;
    rdfs:label "hasVariable" ;
    rdfs:comment "Variable or lookup belonging to a mathematical model; distinct from m4i:hasVariable on assignments." .

sd:inFile a owl:ObjectProperty ;
    rdfs:label "inFile" ;
    rdfs:comment "File targeted by a binding." .

sd:inferredFrom a owl:DatatypeProperty ;
    rdfs:label "inferredFrom" ;
    rdfs:comment "Description of the evidence used to reconstruct a relationship." .

sd:inflowTo a owl:ObjectProperty ;
    rdfs:label "inflowTo" ;
    rdfs:comment "Stock to whose derivative this rate is added." .

sd:informs a owl:ObjectProperty ;
    rdfs:label "informs" ;
    rdfs:comment "A source informs a scientific concept or interpretation." .

sd:initializes a owl:ObjectProperty ;
    rdfs:label "initializes" ;
    rdfs:comment "Stock whose initial condition is supplied by this parameter." .

sd:inputFile a owl:ObjectProperty ;
    rdfs:label "inputFile" ;
