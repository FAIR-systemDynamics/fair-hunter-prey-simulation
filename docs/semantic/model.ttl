sd:MathematicalModel a owl:Class ;
    rdfs:label "MathematicalModel" ;
    rdfs:comment "The mathematical specification, distinct from its file representation." ;
    rdfs:subClassOf schema:CreativeWork .

sd:OutputSpecification a owl:Class ;
    rdfs:comment "Specification of requested output quantities, not an observed dataset." ;
    rdfs:subClassOf prov:Plan .

sd:ReferenceSeries a owl:Class ;
    rdfs:label "ReferenceSeries" ;
    rdfs:comment "A reference-mode series used for comparison." ;
    rdfs:subClassOf m4i:NumericalVariable .

sd:SimulationSetup a owl:Class ;
    rdfs:comment "Plan combining a scenario, initial conditions and numerical settings." ;
    rdfs:subClassOf prov:Plan .

sd:hasFunctionDefinitions a owl:ObjectProperty ;
    rdfs:comment "Tabulated functions used to specify the equations." .

sd:hasGoverningEquations a owl:ObjectProperty ;
    rdfs:comment "Connects a mathematical model to a collection of its governing formulas." .

sd:hasInitialConditions a owl:ObjectProperty ;
    rdfs:comment "Initial conditions required by a setup plan." .

sd:hasNumericalSettings a owl:ObjectProperty ;
    rdfs:comment "Numerical controls and methods required by a setup plan." .

sd:hasParameterGroup a owl:ObjectProperty ;
    rdfs:comment "Collection of configurable scientific and policy quantities." .

sd:hasSimulationSetup a owl:ObjectProperty ;
    rdfs:comment "Task is specified by a simulation setup plan." .

sd:offersScenario a owl:ObjectProperty ;
    rdfs:comment "Alternative scenario configuration available for a setup." .

sd:representsModel a owl:ObjectProperty ;
    rdfs:label "representsModel" ;
    rdfs:comment "Connects an implementation file to its mathematical specification." .

sd:requestsOutput a owl:ObjectProperty ;
    rdfs:comment "A computational task requests these output quantities; no dataset generation is asserted." .

sd:solvesModel a owl:ObjectProperty ;
    rdfs:comment "A computational task asks for a numerical solution of this model." .

