<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#review/case-two> a sd:ReviewIssue ;
    rdfs:label "Case 2 changes four parameters" ;
    dcterms:description "Predator removal changes from 0 to 0.2/year, annual kills per predator from 40 to 20, carrying-capacity horizon from 2 to 4 years, and desired consumption from 0.75 to 0.5. The comparison is not a single-factor experiment." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/config/parameters/basic_parameters.csv>,
        <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/config/scenarios/case2.cin> ;
    sd:concerns <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#configuration/case2> ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#review/consumption-name> a sd:ReviewIssue ;
    rdfs:label "A per-deer name for a herd total" ;
    dcterms:description "Forage Consumed per Deer multiplies Deer Population by Actual Consumption per Deer. Its unit is Metric Tons/Year. The proposed preferred vocabulary label is Total herd forage consumption rate." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L135> ;
    sd:concerns <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/forage-consumed-per-deer> ;
    sd:evidenceStatus "Interpreted" .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#review/density-name> a sd:ReviewIssue ;
    rdfs:label "Density is normalized" ;
    dcterms:description "Deer Density divides population by area and by a reference density. It is dimensionless. Normal Deer Density per Acre is expressed per thousand acres in the model." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L58> ;
