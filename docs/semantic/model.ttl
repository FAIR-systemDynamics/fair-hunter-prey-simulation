<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#mechanism/consumption-depletion> a sd:Mechanism ;
    rdfs:label "Consumption and forage depletion" ;
    dcterms:description "The implemented consumption outflow multiplies the herd size by actual intake per deer. Intake is reduced through a nonlinear lookup when forage becomes scarce. Depletion therefore changes both intake and the capacity supporting future deer growth." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/docs/kaibab_example.md>,
        <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L77> ;
    sd:evidenceStatus "Interpreted" ;
    sd:explainsConcept <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/consumption>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/overshoot> ;
    sd:involvesVariable <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/actual-consumption-per-deer>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/deer-population>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/effect-of-forage-availability-on-consumption>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/forage-biomass>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/forage-consumed-per-deer>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/kaibab-deer-carrying-capacity> .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#mechanism/policy-pathway> a sd:Mechanism ;
    rdfs:label "A policy acts through feedback" ;
    dcterms:description "The STEP expression activates predator removal at Program Start Year. Removal changes predator abundance, which changes predation pressure on deer. Any later overshoot is a model behavior contingent on the complete parameter set, not a consequence asserted for every intervention." ;
    dcterms:source <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/docs/kaibab_example.md>,
        <https://github.com/FAIR-systemDynamics/fair-hunter-prey-simulation/blob/f156dcf37597c0587958f463985986f0ea91accf/models/kaibab_ecosystem_model.mdl#L294> ;
    sd:evidenceStatus "Interpreted" ;
    sd:explainsConcept <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/overshoot>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#concept/policy> ;
    sd:involvesVariable <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/deer-population>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/deer-predation>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/fraction-predators-killed-per-year>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/predator-population>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/predators-hunted>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/program-start-year> .

<https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#overview/numerics> a schema:Collection ;
    rdfs:label "Time & integration" ;
    dcterms:description "1900–1950; time step 0.05 year. The documented Vensim method is RK2 midpoint, while the Stella workflow uses RK2 Heun. The Python runner reproduces the appropriate convention, including STEP handling." ;
    dcterms:hasPart <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/final-time>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/initial-time>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/saveper>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#variable/time-step> ;
    dcterms:source <https://pressbooks.lib.jmu.edu/sdlearningguide/chapter/chapter-4-introduction-to-system-dynamics-modeling/> ;
    sd:evidenceStatus "Interpreted" ;
    sd:offersMethod <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#method/rk2>,
        <https://fair-systemdynamics.github.io/fair-hunter-prey-simulation/semantic/#method/rk2-heun> .

