<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>kaibab_ecosystem_model</name>
		<uuid>74668987-cf61-4577-aa4a-c65e963429c1</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="4.4" isee:build_number="4016" isee:saved_by_v1="true" lang="en">Stella Architect</product>
	</header>
	<ai_information>
		<status verified="true" mixed="false" trusted="true" tampered="false" uses="false" analyzed="false" log_truncated="false" timestamp="1788536892" algorithm="ed25519" keyurl="https://iseesystems.com/keys/stella01.txt" want_var_info="true" want_var_status="false" want_log="false" sampling="1" signature="LiMKMvf/wFivU/07WUpao4AYXsrEvc3N/99ifA5CiJiIxmozkKjeT0XFabgh/rl0BkOSA+ADkKkTzlRegz4QBA=="/>
	</ai_information>
	<sim_specs isee:sim_duration="1.5" isee:run_prefix="Run" isee:simulation_delay="0.03" isee:restore_on_start="false" method="RK2" time_units="Years" isee:instantaneous_flows="false" isee:ignore_module_errors="false" isee:strict_units="true" isee:loop_scores="true" isee:loop_exhaustive_allowed="1000">
		<start>1900</start>
		<stop>1950</stop>
		<dt reciprocal="true">20</dt>
	</sim_specs>
	<isee:prefs saved_runs="5" keep="false" version_control_friendly="true" show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" isee:design="Deluxe Prev-Next Blue Green Pastel" isee:design_custom="false" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" rifp="true">
		<isee:tag_styles>
			<isee:tag_style tag="CHECK" color="#FF40FF" fill_color="#FF40FF"/>
			<isee:tag_style tag="Interface"/>
			<isee:tag_style tag="Output"/>
			<isee:tag_style tag="Parameter" color="#CCCCCC" fill_color="#CCCCCC"/>
			<isee:tag_style tag="Policy"/>
		</isee:tag_styles>
	</isee:prefs>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" max_advance_time_in_ms="0" model_stops_when_players_drop="false" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<isee:number_format_extenders/>
	<default_format/>
	<data>
		<export frequency="on_demand" orientation="horizontal" resource="/Users/mp/Projects/nfdi4sd-test/results/stella-data-scenario2.csv" interval="DT" precomputed="false" isee:format="numbers">
			<isee:tag>Output</isee:tag>
		</export>
		<export frequency="on_demand" resource="r../config/parameters/stella-parameters-scenario2.csv" isee:format="numbers">
			<parameter_values/>
		</export>
	</data>
	<isee:sensi_specs_list active_index="0">
		<isee:sensi_specs name="Sensitivity" method="sobol_sequence" runs="0"/>
	</isee:sensi_specs_list>
	<isee:optimizer_specs_list active_index="0">
		<isee:optimizer_specs name="Optimization" method="Powell" use_additional_starts_file="false" additional_starts="0" report_interval="1" confidence_range="0"/>
	</isee:optimizer_specs_list>
	<isee:payoff_specs_list>
		<isee:payoff_specs name="Payoff" calibration="true" recompute_weights="true" compare_tolerance="0" compare_type="ls" compare_run="-1"/>
	</isee:payoff_specs_list>
	<model_units>
		<unit name="Dimensionless">
			<eqn>1</eqn>
			<alias>dmnl</alias>
			<alias>unitless</alias>
			<alias>fraction</alias>
		</unit>
		<unit name="Tonnes">
			<eqn/>
			<alias>tonne</alias>
			<alias>metric ton</alias>
		</unit>
		<unit name="Years">
			<eqn/>
			<alias>yr</alias>
			<alias>year</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<aux name="Initial\nDeer Population">
				<doc>${Parameter}
This is an exogenous variable that can be used to set (and change) the initial size of the Deer Population.</doc>
				<eqn>4000</eqn>
				<format precision="100" scale_by="1" delimit_000s="true"/>
				<range min="2000" max="8000"/>
				<units>Deer</units>
			</aux>
			<aux name="Baseline\nFractional Deer\nGrowth Rate">
				<doc>${Parameter}
This variable stands for the fractional net growth rate of the Population whenever there are abundant resources on which to live.</doc>
				<eqn>1.0</eqn>
				<format precision="0.01" scale_by="1"/>
				<range min="0.5" max="1.5"/>
				<units>1/Year</units>
			</aux>
			<aux name="Actual Fractional Net Growth Rate">
				<doc>This represents the actual Fractional Net Growth Rate of the Population, after accounting for the Adequacy of the Ecosystem to Support Growth of the population. It is calculated by multiplying the Baseline Fractional Net Growth rate times the Adequacy of the Ecosystem to Support Continued Growth. This, in effect, scales down the Baseline Fractional Growth Rate, according to how close the Population is to the Carrying Capacity.</doc>
				<eqn>Baseline_Fractional_Deer_Growth_Rate*Kaibab_Adequacy_to_Support_the_Deer_Population</eqn>
				<units>1/Year</units>
			</aux>
			<aux name="Kaibab Adequacy to Support the Deer Population">
				<doc>This variable is calculated as 1 – (Ratio of Population to Carrying Capacity). When the Population is well below the Carrying Capacity (and the Ratio of Population to Carrying Capacity is hence close to zero), the Adequacy of the Ecosystem to Support Continued Growth value will be close to 1. As the Population approaches the Carrying Capacity (and the Ratio of Population to Carrying Capacity hence approaches 1), thus the Adequacy of  the Ecosystem to Support Continued Growth will approach zero. Higher Adequacy of the Ecosystem to Support Continued Growth values imply that the Population can grow at a more rapid pace. It has units that are dimensionless or a fraction.</doc>
				<eqn>1-Ratio_of_the_Deer_Population_to_Carrying_Capacity</eqn>
				<format precision="1000" scale_by="1"/>
				<range min="4000" max="60000"/>
				<units>dmnl</units>
			</aux>
			<aux name="Ratio of the Deer Population\nto Carrying Capacity">
				<doc>This is calculated as the ratio of the Population to the Carrying capacity. This Ratio is less than 1 when the current Population size is less than the Carrying Capacity. In this case, the Population still has “room to grow” in the ecosystem.  However, as the Population nears the Carrying Capacity, the Ratio of Population to Carrying Capacity will get close to 1. As this happens, the Fractional Net Growth Rate should slow, moving toward a value of zero.</doc>
				<eqn>Deer_Population//Kaibab_Deer_Carrying_Capacity</eqn>
				<units>dmnl</units>
			</aux>
			<stock name="Deer\nPopulation">
				<doc>${Output}
The deer population on the Kaibab Plateau</doc>
				<eqn>Initial_Deer_Population</eqn>
				<inflow>Deer_Net_Growth_Rate</inflow>
				<outflow>Deer_Predation</outflow>
				<units>Deer</units>
			</stock>
			<flow name="Deer\nNet Growth Rate">
				<doc>With population data, we seldom know the Fractional Birth Rate and Fractional Death Rate, but we can often use historical data to calculate the Fractional Net Growth Rate. In addition, it turns out that the Fractional Net Growth Rate is the difference between the Fractional Birth Rate and the Fractional Death Rate.</doc>
				<eqn>Actual_Fractional_Net_Growth_Rate*Deer_Population</eqn>
				<units>Deer/Years</units>
			</flow>
			<aux name="Kaibab\nDeer\nCarrying Capacity">
				<doc>This is the population size that the ecosystem can sustain for the long term.</doc>
				<eqn>Forage_Biomass/(

Desired_Consumption_per_Deer*Deer_Carrying_Capacity_in_Years
)</eqn>
				<format precision="1000" scale_by="1" delimit_000s="true"/>
				<range min="4000" max="60000"/>
				<units>Deer</units>
			</aux>
			<aux name="Baseline Annual Kills Per Predator">
				<doc>${Parameter}
The number of deer that would be killed per predator each year, assuming that there was a natural balance between the predator and deer populations. </doc>
				<eqn>40</eqn>
				<format precision="0.1" scale_by="1"/>
				<range min="20" max="60"/>
				<units>Deer/(Predators*Year)</units>
			</aux>
			<stock name="Predator\nPopulation">
				<doc>${Output}
Number of predators on the Kaibab Plateau</doc>
				<eqn>Initial_Predator_Population</eqn>
				<inflow>Net_Predator_Growth_Rate</inflow>
				<outflow>Predators_Hunted</outflow>
				<units>Predators</units>
			</stock>
			<aux name="Effect of Deer Density on Predator Efficiency">
				<doc>${Parameter}
This is a dimensionless value used as a multiplier to increase or decrease the Deer Predation, according to the Deer Density level. This value varies between 0 and 1.5. Its value is 0 when there are no deer present (i.e. when deer density = 0 deer per 1000 acres) and it is 1.5 when there is an abundance of deer (i.e. when the deer density reaches 10 deer per 1000 acres or more). Hence, if there are no deer present, the Deer predation will fall to zero. If there is an overabundance of deer, the Deer Predation will be 1.5 times as great as it would be in equilibrium.  This variable was formatted in the diagram to use a boldface, underline font to highlight that its value is not set by an equation, but by a graphical function showing how the Effect is calculated based on the Deer Density.</doc>
				<eqn>Deer_Density</eqn>
				<gf>
					<xscale min="0" max="2"/>
					<yscale min="0" max="2"/>
					<ypts>0,0.05,0.15,0.35,0.7,1,1.2,1.3,1.4,1.45,1.5</ypts>
				</gf>
				<units>dmnl</units>
			</aux>
			<aux name="Deer Density">
				<doc>The ratio of deer to area all of which is divided by a normal.  Results in a scale where one is normal and anything above 1 indicates that you have too many deer and anything below one indicates that you have to few deer compared to what is normal deer per acres.</doc>
				<eqn>(Deer_Population//Kaibab_Area_in_Thousands_of_Acres)/Normal_Deer_Density_per_Acre</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Kaibab Area in Thousands of Acres">
				<doc>${Parameter}
Land area of the Kaibab Plateau.  This is approximately 800,000 acres.  We are measuring this in thousands of acres so that is why we use 800 when setting the value.</doc>
				<eqn>800</eqn>
				<units>K acres</units>
			</aux>
			<aux name="Normal\nDeer Density\nper Acre">
				<doc>${Parameter}
The number of deer per acre under ideal conditions. </doc>
				<eqn>5</eqn>
				<units>Deer/K acres</units>
			</aux>
			<aux name="Initial\nPredator Population">
				<doc>${Parameter}
Used to set the initial size of the Predator Population.  Notice that this is different from the original predator-prey model you built.</doc>
				<eqn>100</eqn>
				<format precision="1" scale_by="1"/>
				<range min="20" max="130"/>
				<units>Predators</units>
			</aux>
			<flow name="Net\nPredator\nGrowth Rate">
				<doc>The net number of predators added to (or removed from) the Predator Population each year through the natural birth and death processes. This value is calculated as the product of the Predator Population, the Baseline Fractional Predator Growth Rate, and the Effect of Deer Density on Predator Births.</doc>
				<eqn>Predator_Population*Baseline_Fractional_Predator_Growth_Rate*Effect_of_Deer_Density_on_Predator_Births</eqn>
				<format scale_by="1" delimit_000s="true"/>
				<units>Predators/Years</units>
			</flow>
			<aux name="Baseline Fractional Predator Growth Rate">
				<doc>${Parameter}
This represents the fraction by which the Predator Population will grow each year, assuming there are an abundance of deer available for food. </doc>
				<eqn>0.5</eqn>
				<format precision="0.01" scale_by="1"/>
				<range min="0.5" max="1.5"/>
				<units>1/Year</units>
			</aux>
			<aux name="Effect of Deer Density on Predator Births">
				<doc>${Parameter}
This is a dimensionless value used to represent how the Deer Density on the Kaibab Plateau affects the growth rates of the predator herd. This variable is used as a multiplier to increase or decrease the Net Predator Growth Rate, according to the Deer Density value (with greater density implying more food for predators, and hence a greater reproductive rate). This Effect  of Deer Density on Predator Births variable is also determined by a graphical relationship with Deer Density. When the Deer density is 0, the Effect is -1.0, meaning that the Predator population will experience negative growth (from a lack of food). When the Deer density is 1, the effect is 0, meaning that the Predator Population will experience flat growth (neither growing nor shrinking). When the Deer Density is more than 2 , the Effect of Deer Density on Predator Births is 1.5, meaning that the Predator Population will grow at 1.5 times the Baseline Fractional Net Growth Rate (because there are abundant deer available for food).	</doc>
				<eqn>Deer_Density</eqn>
				<gf>
					<xscale min="0" max="2"/>
					<yscale min="-1.5" max="1.5"/>
					<ypts>-1,-0.95,-0.9,-0.8,-0.5,0,0.5,0.8,0.9,0.95,1</ypts>
				</gf>
				<units>dmnl</units>
			</aux>
			<flow name="Deer\nPredation">
				<doc>The number of animals killed by predators per year.</doc>
				<eqn>Baseline_Annual_Kills_Per_Predator*Predator_Population*Effect_of_Deer_Density_on_Predator_Efficiency</eqn>
				<non_negative/>
				<units>Deer/Years</units>
			</flow>
			<stock name="Forage\nBiomass">
				<doc>${Output}
Forage available for deer to eat</doc>
				<eqn>317000</eqn>
				<inflow>Net_Annual_Forage_Growth</inflow>
				<outflow>Forage_Consumed_by_Deer</outflow>
				<units>metric ton</units>
			</stock>
			<flow name="Net Annual\nForage Growth">
				<doc>Net change in the forage biomass on the Kaibab via natural growth and decay, apart from consumption by animals.</doc>
				<eqn>Actual_Biomass_Growth_Fraction*
Forage_Biomass</eqn>
				<non_negative/>
				<units>metric ton/Years</units>
			</flow>
			<flow name="Forage\nConsumed by Deer">
				<doc>Change in the forage biomass on the Kaibab via consumption by animals.</doc>
				<eqn>Actual_Consumption_per_Deer*Deer_Population</eqn>
				<non_negative/>
				<units>metric ton/Years</units>
			</flow>
			<aux name="Kaibab\nForage\nCarrying Capacity">
				<doc>${Parameter}
Amount of forage biomass that the Kaibab can support on an ongoing basis.</doc>
				<eqn>350000</eqn>
				<format precision="1000" scale_by="1000" delimit_000s="true"/>
				<range min="200000" max="600000"/>
				<units>metric ton</units>
			</aux>
			<aux name="Ratio of\nForage to\nForage Carrying Capacity">
				<doc>This is calculated as the ratio of the Forage Biomass to the Carrying capacity. This Ratio is less than 1 when the current Forage Biomass is less than the Carrying Capacity. In this case, the Forage Biomass still has “room to grow” in the ecosystem.  However, as the Forage Biomass nears the Carrying Capacity, the Ratio of Forage Biomass to Carrying Capacity will get close to 1. As this happens, the Fractional Net Growth Rate should slow, moving toward a value of zero.</doc>
				<eqn>Forage_Biomass/Kaibab_Forage_Carrying_Capacity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Kaibab\nAdequacy fo\nForage">
				<doc>This variable is calculated as 1 – (Ratio of Forage  to Forage Carrying Capacity). When the Biomass is well below the Carrying Capacity, the Adequacy of the Ecosystem to Support Continued Growth value will be close to 1. As the Biomass approaches the Carrying Capacity, thus the Adequacy of  the Ecosystem to Support Continued Growth will approach zero. Higher Adequacy of the Ecosystem to Support Continued Growth values imply that the Biomass can grow at a more rapid pace.</doc>
				<eqn>1-Ratio_of_Forage_to_Forage_Carrying_Capacity</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Actual\nBiomass\nGrowth Fraction">
				<doc>This represents the actual Fractional Net Growth Rate of the Biomass, after accounting for the Carrying Capacity of the Ecosystem</doc>
				<eqn>Baseline_Biomass_Growth_Fraction*Kaibab_Adequacy_fo_Forage</eqn>
				<units>1/Year</units>
			</aux>
			<aux name="Baseline Biomass Growth Fraction">
				<doc>${Parameter}
This variable stands for the fractional net growth rate of the Biomass whenever there are no restrictions of the carrying capacity.</doc>
				<eqn>0.10</eqn>
				<format precision="0.01" scale_by="1"/>
				<range min="0.05" max="0.25"/>
				<units>1/Year</units>
			</aux>
			<aux name="Required\nForage Biomass">
				<doc>Forage biomass needed to sustain the existing deer population for the number of years indicated by the value of the Deer Carrying Capacity in Years.</doc>
				<eqn>(Deer_Population*Desired_Consumption_per_Deer)
*Deer_Carrying_Capacity_in_Years</eqn>
				<units>metric ton</units>
			</aux>
			<aux name="Deer\nCarrying Capacity\nin Years">
				<doc>${Parameter}
Number of years of forage needed to sustain the deer population.</doc>
				<eqn>2</eqn>
				<format precision="0.1" scale_by="1"/>
				<range min="1" max="7"/>
				<units>Years</units>
			</aux>
			<aux name="Desired\nConsumption\nper Deer">
				<doc>${Parameter}
The amount of forage consumed by a single deer in a year, when abundant forage is available.</doc>
				<eqn>0.75</eqn>
				<format precision="0.01" scale_by="1"/>
				<range min="0.4" max="0.8"/>
				<units>metric ton/deer/year</units>
			</aux>
			<aux name="Actual\nConsumption\nper Deer">
				<doc>The actual amount of forage biomass consumed per deer.</doc>
				<eqn>Desired_Consumption_per_Deer*Effect_of_Forage_Availability_on_Consumption</eqn>
				<units>metric ton/deer/year</units>
			</aux>
			<aux name="Ratio of\nActual to Required\nBiomass">
				<doc>Measures how much forage is available, relative to what is need to sustain the current deer population.  Values below 1 indicate a shortage of forge biomass.</doc>
				<eqn>Forage_Biomass//Required_Forage_Biomass</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="Effect of\nForage Availability on Consumption">
				<doc>${Parameter}
This nonlinear or graphical function captures how Actual Consumption per Deer will change given the Ratio of Actual to Required Biomass.  Deer will continue to eat a normal amount of forage until only about 30 percent of what is need is available.  Deer will then start to eat less as foraging becomes more difficult.</doc>
				<eqn>Ratio_of_Actual_to_Required_Biomass</eqn>
				<gf>
					<xscale min="0" max="1"/>
					<yscale min="0" max="2"/>
					<ypts>0,0.59,0.84,0.93,0.97,0.99,0.9957,0.9983,0.9994,0.9998,1</ypts>
				</gf>
				<units>dmnl</units>
			</aux>
			<flow name="Predators\nHunted">
				<doc>Number of predators removed each year through hunting.</doc>
				<eqn>STEP(Predator_Population*Fraction_Predators_Killed_per_Year, Program_Start_Year)</eqn>
				<non_negative/>
				<units>Predators/Years</units>
			</flow>
			<aux name="Program\nStart Year">
				<doc>${Parameter}
The year the predator hunting policy is implemented.  From that year on, a fraction of the remaining predators will be hunted and killed each year.</doc>
				<eqn>1907</eqn>
				<format precision="1" scale_by="1"/>
				<range min="1905" max="1920"/>
				<units>year</units>
			</aux>
			<aux name="Fraction\nPredators Killed\nper Year">
				<doc>${Parameter}
Fraction of predators killed each year.</doc>
				<eqn>0</eqn>
				<format precision="0.01" scale_by="1"/>
				<range min="0" max="0.5"/>
				<units>1/Year</units>
			</aux>
			<aux name="Historical\nDeer\nBehavior Over Time">
				<doc>${Output}
A reference mode showing the actual deer population estimates from 1900 through 1950.  This is defined by the graphical function shown here.  You can display this BOTG with the Deer Population to help us tune the model parameters to match the historical record.</doc>
				<eqn>TIME</eqn>
				<gf>
					<xscale min="1900" max="1950"/>
					<yscale min="0" max="100"/>
					<ypts>4000,4000,4000,5000,9000,15000,25000,35000,65000,90000,60000,37000,25000,20000,18000,12000,10000,7000,5000,3000,2000</ypts>
				</gf>
				<units>Deer</units>
			</aux>
			<group name="Kaibab Ecosystem Model" run="false">
				<entity name="Actual_Biomass_Growth_Fraction"/>
				<entity name="Actual_Consumption_per_Deer"/>
				<entity name="Actual_Fractional_Net_Growth_Rate"/>
				<entity name="Baseline_Annual_Kills_Per_Predator"/>
				<entity name="Baseline_Biomass_Growth_Fraction"/>
				<entity name="Baseline_Fractional_Deer_Growth_Rate"/>
				<entity name="Baseline_Fractional_Predator_Growth_Rate"/>
				<entity name="Deer_Carrying_Capacity_in_Years"/>
				<entity name="Deer_Density"/>
				<entity name="Deer_Net_Growth_Rate"/>
				<entity name="Deer_Population"/>
				<entity name="Deer_Predation"/>
				<entity name="Desired_Consumption_per_Deer"/>
				<entity name="Effect_of_Deer_Density_on_Predator_Births"/>
				<entity name="Effect_of_Deer_Density_on_Predator_Efficiency"/>
				<entity name="Effect_of_Forage_Availability_on_Consumption"/>
				<entity name="Forage_Biomass"/>
				<entity name="Forage_Consumed_by_Deer"/>
				<entity name="Fraction_Predators_Killed_per_Year"/>
				<entity name="Historical_Deer_Behavior_Over_Time"/>
				<entity name="Initial_Deer_Population"/>
				<entity name="Initial_Predator_Population"/>
				<entity name="Kaibab_Adequacy_fo_Forage"/>
				<entity name="Kaibab_Adequacy_to_Support_the_Deer_Population"/>
				<entity name="Kaibab_Area_in_Thousands_of_Acres"/>
				<entity name="Kaibab_Deer_Carrying_Capacity"/>
				<entity name="Kaibab_Forage_Carrying_Capacity"/>
				<entity name="Net_Annual_Forage_Growth"/>
				<entity name="Net_Predator_Growth_Rate"/>
				<entity name="Normal_Deer_Density_per_Acre"/>
				<entity name="Predator_Population"/>
				<entity name="Predators_Hunted"/>
				<entity name="Program_Start_Year"/>
				<entity name="Ratio_of_Actual_to_Required_Biomass"/>
				<entity name="Ratio_of_Forage_to_Forage_Carrying_Capacity"/>
				<entity name="Ratio_of_the_Deer_Population_to_Carrying_Capacity"/>
				<entity name="Required_Forage_Biomass"/>
			</group>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
				<text_box color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt"/>
