{UTF-8}
Stock= INTEG (
	Growth,
		1)
	~	Widget
	~	Analytic solution: Stock(t) = exp(r*t)
	|

Growth=
	Stock * r
	~	Widget/Year
	~		|

r=
	0.5
	~	1/Year
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 10
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  =
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.25
	~	Year [0,?]
	~	The time step for the simulation.
	|

